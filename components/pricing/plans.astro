---
import { pricingPage } from '@/data/pages';
import { site } from '@/data/site';
import Icon from '@/components/shared/icons/icon.astro';
import Button from '@/components/shared/ui/button.astro';
import NumberFlow from '@/components/shared/ui/number-flow.astro';
import { plans } from '@/data/pricing';
import { cn } from '@/utils/cn';

const copy = pricingPage.plans;
---

<section
  class="shell pb-24 md:pb-32"
  data-pricing
  aria-labelledby="plans-title">
  <h2 id="plans-title" class="sr-only">
    代理方案
  </h2>
  
  <!-- 顶部提示文字 -->
  <div class="mt-8 flex justify-center" data-reveal>
    <p class="text-sm text-mute">{copy.note}</p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-3 lg:grid-cols-3">
    {plans.map((plan) => (
      <article
        class={cn(
          'relative flex flex-col border p-6 md:p-8',
          plan.featured ? 'border-signal bg-ink-2' : 'border-line bg-ink',
        )}
        data-reveal>
        <div class="flex items-center justify-between gap-4">
          <h3 class="font-display text-subtitle font-bold text-bone">{plan.name}</h3>
          {plan.featured && (
            <span class="rounded-full bg-signal-soft px-3 py-1 font-mono text-[0.6875rem] text-signal uppercase">
              {copy.featuredLabel}
            </span>
          )}
        </div>
        <p class="mt-3 min-h-12 text-mute">{plan.description}</p>
        
        <!-- 🌟 简化后的价格显示，彻底去掉了周期切换逻辑 -->
        <p class="mt-10 flex items-end gap-2">
          <span class="font-display text-[clamp(3.5rem,5vw,4.75rem)] leading-[0.85] font-extrabold tracking-[-0.04em] text-bone">
            <NumberFlow value={plan.monthly} prefix="¥" duration={1.1} />
          </span>
          <span class="pb-1 text-sm text-mute">
            / 首次
          </span>
        </p>
        <p class="mt-3 h-5 text-sm text-dim">
          一次性门槛费，无隐藏续费
        </p>
        
        <div class="mt-8">
          <Button label={plan.cta} href={plan.href} variant={plan.featured ? 'signal' : 'outline'} class="w-full" />
        </div>
        <ul class="mt-10 flex flex-col gap-3 border-t border-line pt-8">
          {plan.features.map((feature) => (
            <li class="flex items-start gap-3 text-sm text-bone">
              <Icon name="check" class="mt-0.5 text-signal" />
              {feature}
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
  
  <p class="mt-8 text-center text-sm text-mute" data-reveal>
    {copy.enterprise.prompt}{' '}
    <a href={site.cta.secondary.href} class="text-bone underline decoration-signal underline-offset-4">
      {copy.enterprise.link}
    </a>
    .
  </p>
</section>